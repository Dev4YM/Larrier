# What runs on macOS and Linux keeps Unix line endings, even in a Windows
# checkout: a script copied into Docker or WSL with CRLF endings fails.
*.sh       text eol=lf
*.desktop  text eol=lf
Dockerfile text eol=lf

# The spelling dictionary is read as is (Hunspell files, Unix line endings).
app/dict/** text eol=lf

# The code editor (Monaco), vendored as published: kept byte for byte.
app/assets/monaco/** -text
